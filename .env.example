NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Runtime: Supavisor transaction pooler (6543) ou conexão PostgreSQL compatível.
DATABASE_URL="postgresql://postgres.seu-projeto:senha@pooler.supabase.com:6543/postgres"
# Migrations: conexão direta ou Supavisor session pooler (5432).
DIRECT_URL="postgresql://postgres.seu-projeto:senha@pooler.supabase.com:5432/postgres"
APP_URL="http://localhost:3000"
ARMAZENAMENTO_LOCAL_DIRETORIO="./armazenamento"
# CA oficial PostgreSQL, quando a cadeia do provedor exigir. Nunca desative a validação TLS.
POSTGRES_CA_CERTIFICADO=""
# Servidor/CLI administrativos: necessária para convites do painel. Nunca NEXT_PUBLIC.
SUPABASE_SECRET_KEY=""

# Landing pública; nenhum segredo ou dado de uma empresa cliente.
LANDING_NOME="OrçaFácil"
# Caminho de uma imagem estática em public, por exemplo /marca/logo.svg.
LANDING_LOGO=""
# Link real wa.me com DDI ou https://api.whatsapp.com/send?phone=...
LANDING_WHATSAPP_URL=""
# Configure a origem HTTPS real antes de publicar e habilitar indexação.
LANDING_SITE_URL=""
LANDING_PRIVACIDADE_URL=""
LANDING_TERMOS_URL=""
LANDING_RESPONSAVEL=""
